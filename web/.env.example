# From Firebase console: Project settings > General > Your apps > Web app config.
# These values are public; they identify the project, they don't grant access.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Use the local Auth emulator (npm run emulators) instead of the real project
VITE_USE_AUTH_EMULATOR=true

# Leave empty in development (Vite proxies /api to localhost:4000).
# In production, the Render URL, e.g. https://illi-knows-api.onrender.com
VITE_API_URL=
