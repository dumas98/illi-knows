NODE_ENV=development
PORT=4000

# Local MongoDB, or your Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/illi-knows

# Comma-separated list of web origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Firebase project ID. "demo-illi-knows" works with the local Auth emulator.
FIREBASE_PROJECT_ID=demo-illi-knows
# Set this to use the local Auth emulator (npm run emulators). Remove it in production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Optional. Verifying sign-ins only needs the project ID. Set this (service account JSON,
# base64-encoded) only if the API ever has to manage Firebase users itself.
# FIREBASE_SERVICE_ACCOUNT_BASE64=

ALLOWED_EMAIL_DOMAIN=illinois.edu
REQUIRE_VERIFIED_EMAIL=true

# Shared secret the Python extractor sends in the X-Api-Key header (see docs/ingestion-contract.md).
# Any random string of 16+ characters. Without it, POST /api/ingest/listings answers 503.
# INGEST_API_KEY=

# Turns on the "View as" persona switcher. Keep off in production.
DEMO_MODE=true
